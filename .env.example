# Use "latest" for automatic stable updates or a release such as "0.1.1" to pin it.
MNEME_VERSION=latest
MNEME_LOCAL_PORT=8080

# Photon downloads this region on its first start.
PHOTON_LOCAL_PORT=2322
PHOTON_REGION=belgium
PHOTON_LANGUAGES=nl,fr,de,en

# Only required when starting the optional Cloudflare Tunnel profile.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
