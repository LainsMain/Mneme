# Docker images use lowercase namespaces.
MNEME_IMAGE=egoisticfoil/mneme-server:latest
MNEME_LOCAL_PORT=8080
MNEME_VERSION=0.1.0-dev
PHOTON_LOCAL_PORT=2322
PHOTON_REGION=belgium
PHOTON_LANGUAGES=nl,fr,de,en

# This is the Cloudflare tunnel token, not a Mneme Android app token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
